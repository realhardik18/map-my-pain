# Local MongoDB (started with `npm run db:up`)
MONGODB_URI=mongodb://localhost:27017/mapmypain

# Secret used to sign session cookies — any long random string
AUTH_SECRET=change-me-to-a-long-random-string

# OpenRouter (https://openrouter.ai/keys) — free tier works
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
